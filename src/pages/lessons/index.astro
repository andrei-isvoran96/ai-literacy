---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import LessonCard from '../../components/LessonCard.astro';
import { getSortedLessons } from '../../lib/lessons';

const lessons = await getSortedLessons();
const track = lessons[0]?.data.track ?? 'Agentic Engineering';
---
<BaseLayout
  title="Lessons"
  description="Hands-on lessons on agentic engineering for developers."
>
  <Container>
    <section class="py-16">
      <p class="eyebrow">Track</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">{track}</h1>
      <p class="mt-4 max-w-2xl text-lg text-fg-muted">
        A hands-on path through how AI agents actually work — what they know,
        what they do, and how you know they work. Each lesson ends with an
        interactive widget you can poke at.
      </p>

      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          lessons.map((lesson) => (
            <li class="contents">
              <LessonCard lesson={lesson} />
            </li>
          ))
        }
      </ol>
    </section>
  </Container>
</BaseLayout>

---
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Container.astro';
import ReadingMeta from '../components/ReadingMeta.astro';
import TableOfContents from '../components/TableOfContents.astro';
import PrevNext from '../components/PrevNext.astro';
import { lessonNumber, lessonOgPath, type Lesson } from '../lib/lessons';

interface Props {
  lesson: Lesson;
  headings: MarkdownHeading[];
  prev: Lesson | null;
  next: Lesson | null;
  minutes: number;
}
const { lesson, headings, prev, next, minutes } = Astro.props;
const num = lessonNumber(lesson);
---
<BaseLayout
  title={lesson.data.title}
  description={lesson.data.description}
  image={lessonOgPath(lesson)}
>
  <Container size="wide">
    <div class="py-12 lg:grid lg:grid-cols-[minmax(0,1fr)_15rem] lg:gap-12">
      <article class="min-w-0 max-w-3xl">
        <header class="mb-10">
          <p class="eyebrow">{lesson.data.track} · Lesson {num}</p>
          <h1 class="mt-3 text-4xl font-semibold tracking-tight">
            {lesson.data.title}
          </h1>
          <p class="mt-4 text-lg text-fg-muted">{lesson.data.description}</p>
          <ReadingMeta
            difficulty={lesson.data.difficulty}
            minutes={minutes}
            class="mt-5"
          />
        </header>

        <div class="prose">
          <slot />
        </div>

        <PrevNext prev={prev} next={next} />
      </article>

      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

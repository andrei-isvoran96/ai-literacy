---
// Overrides the <pre> emitted by Shiki to add a header bar (language + copy).
// The original Shiki classes/styles are preserved so the theme still applies.
const { 'data-language': lang, class: shikiClass, ...rest } = Astro.props;
---
<figure class="code-block group relative my-6 overflow-hidden rounded-lg border border-border bg-surface-2">
  <figcaption
    class="flex items-center justify-between border-b border-border px-4 py-2"
  >
    <span class="font-mono text-xs text-fg-subtle">{lang ?? 'code'}</span>
    <button
      type="button"
      data-copy
      class="copy-btn rounded-md px-2 py-1 font-mono text-xs text-fg-subtle transition hover:bg-surface-3 hover:text-fg"
      aria-label="Copy code to clipboard"
    >
      Copy
    </button>
  </figcaption>
  <pre
    class:list={[shikiClass, 'm-0 overflow-x-auto p-4 text-sm leading-relaxed']}
    data-language={lang}
    {...rest}><slot /></pre>
</figure>

<script>
  document
    .querySelectorAll<HTMLButtonElement>('.code-block [data-copy]')
    .forEach((btn) => {
      btn.addEventListener('click', async () => {
        const pre = btn.closest('.code-block')?.querySelector('pre');
        if (!pre) return;
        try {
          await navigator.clipboard.writeText(pre.innerText);
          const original = btn.textContent;
          btn.textContent = 'Copied!';
          btn.classList.add('text-success');
          window.setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('text-success');
          }, 1500);
        } catch {
          /* clipboard unavailable */
        }
      });
    });
</script>

---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{
  toc.length > 0 && (
    <nav aria-label="Table of contents">
      <p class="eyebrow mb-3">On this page</p>
      <ul class="space-y-1 border-l border-border">
        {toc.map((h) => (
          <li>
            <a
              href={`#${h.slug}`}
              data-toc-link={h.slug}
              class:list={[
                'toc-link block border-l border-transparent py-1 text-sm leading-snug -ml-px',
                h.depth === 3 ? 'pl-6' : 'pl-3',
              ]}
            >
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc-link {
    color: var(--color-fg-subtle);
    transition: color 0.15s, border-color 0.15s;
  }
  .toc-link:hover {
    color: var(--color-fg);
  }
  .toc-link.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
  );
  if (links.length > 0) {
    const bySlug = new Map(links.map((l) => [l.dataset.tocLink!, l]));
    const headings = links
      .map((l) => document.getElementById(l.dataset.tocLink!))
      .filter((el): el is HTMLElement => el !== null);

    let activeSlug = '';
    const setActive = (slug: string) => {
      if (slug === activeSlug) return;
      activeSlug = slug;
      links.forEach((l) => l.classList.remove('is-active'));
      bySlug.get(slug)?.classList.add('is-active');
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -65% 0px', threshold: 0 },
    );

    headings.forEach((h) => observer.observe(h));
  }
</script>

---
import Badge from './Badge.astro';

interface Props {
  difficulty: 'beginner' | 'intermediate' | 'advanced';
  minutes: number;
  class?: string;
}
const { difficulty, minutes, class: className = '' } = Astro.props;
---
<div class:list={['flex flex-wrap items-center gap-3 text-sm text-fg-subtle', className]}>
  <Badge variant="difficulty" difficulty={difficulty} />
  <span class="flex items-center gap-1.5">
    <svg
      class="h-3.5 w-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 2"></path>
    </svg>
    {minutes} min read
  </span>
</div>

---
import Container from './Container.astro';
import { withBase } from '../lib/lessons';

// Normalize the current path by stripping the base, so active-state works
// regardless of whether Astro.url.pathname includes it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
let path = Astro.url.pathname;
if (base && path.startsWith(base)) path = path.slice(base.length) || '/';

const links = [
  { href: '/', label: 'Home' },
  { href: '/lessons', label: 'Lessons' },
];
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header
  class="sticky top-0 z-50 border-b border-border bg-bg/70 backdrop-blur-md"
>
  <Container size="wide">
    <nav class="flex h-16 items-center justify-between" aria-label="Primary">
      <a href={withBase('/')} class="group flex items-center gap-2.5">
        <span
          class="grid h-8 w-8 place-items-center rounded-lg bg-gradient-to-br from-accent to-violet-dim font-mono text-sm font-bold text-bg transition group-hover:shadow-glow-cyan"
          aria-hidden="true"
        >&gt;_</span>
        <span class="text-sm font-semibold tracking-tight">
          AI&nbsp;Literacy
        </span>
      </a>

      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((link) => (
            <li>
              <a
                href={withBase(link.href)}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-1.5 transition',
                  isActive(link.href)
                    ? 'text-accent'
                    : 'text-fg-muted hover:text-fg',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</header>
